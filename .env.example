# Провайдер языковой модели: openai или anthropic
AI_PROVIDER=openai

# Ключ OpenAI. Нужен, если AI_PROVIDER=openai
OPENAI_API_KEY=

# Модель OpenAI
OPENAI_MODEL=gpt-4o-mini

# Ключ Anthropic. Нужен, если AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Модель Anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
